# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# The scaffold commits this by default, but it records runtime and role ARNs
# that embed the AWS account id. agentcore deploy regenerates it, and
# cdk/bin/cdk.ts tolerates its absence.
# !.cli/deployed-state.json
